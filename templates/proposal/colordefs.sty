% An unknown name is an error.
\newcommand{\colordefspalette}[1]{%
	\@ifundefined{coldefs@palette@#1}%
		{\PackageError{colordefs}{Unknown palette `#1'}%
			{Valid names are pal1 to pal8.}}%
		{\csname coldefs@palette@#1\endcsname}%
}

\colordefspalette{pal7}	% the default; override with \colordefspalette
