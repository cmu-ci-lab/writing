\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{colordefs}[2026/08/04 v1.0 CIRL colors and palettes]

% Usage:
%   \usepackage{colordefs}
%   \colordefspalette{pal3}   % optional, pal7 is the default

\@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}	% provide `definecolor' and `colorlet'

%% categorical palettes
% Eight interchangeable 4-color palettes.
%   palette CVD dE  min dL*  scheme
%   pal1    11.4     11.8  Okabe-Ito, print-first
%   pal2    11.0      3.6  Okabe-Ito, conventional
%   pal3     8.9      8.1  Tol Bright, print-first
%   pal4     8.9      1.1  Tol Bright, official first four
%   pal5    14.8     15.2  Tol Muted, first four
%   pal6    16.6     11.8  Okabe-Ito subset A
%   pal7     3.1      9.1  Tol High-Contrast, plus a neutral (default)
%   pal8     1.2      0.8  the maintainer's own int* colors
% CVD dE is the smallest pairwise OkLab distance under protanopia and
% deuteranopia -- the common forms, together about 8% of males; above
% roughly 10 is usable. min dL* is the smallest adjacent CIELAB
% lightness gap, which is what survives a grayscale print; above roughly
% 8 is separable. Only pal1, pal5 and pal6 clear both bars.

% pal1 -- Okabe-Ito, print-first
% blue, orange, bluish green, yellow
\definecolor{pal1base1}{HTML}{0072B2}	% blue
\definecolor{pal1bg1}{HTML}{D9EAF3}
\definecolor{pal1title1}{HTML}{006BAB}
\definecolor{pal1base2}{HTML}{E69F00}	% orange
\definecolor{pal1bg2}{HTML}{FBF1D9}
\definecolor{pal1title2}{HTML}{9A6000}
\definecolor{pal1base3}{HTML}{009E73}	% green
\definecolor{pal1bg3}{HTML}{D9F0EA}
\definecolor{pal1title3}{HTML}{007850}
\definecolor{pal1base4}{HTML}{F0E442}	% yellow
\definecolor{pal1bg4}{HTML}{FDFBE3}
\definecolor{pal1title4}{HTML}{767500}

