% A document names `boxbase1' to `boxbase4', `boxbg1' to
% `boxbg4', and `boxtitle1' to `boxtitle4', and switches
% every color in the document by changing one preamble line:
%   \colordefspalette{pal5}
% Typical use, with the boxes from boxdefs:
%   \begin{titledbox}[colback=boxbg1,colframe=boxtitle1]{Title}...\end{titledbox}
%   \mathbox{boxtitle1}{boxbg1}{label}{x+y}
%   \mathboxnt{boxbg1}{x+y}
\@namedef{coldefs@palette@pal1}{%
	\colorlet{boxbase1}{pal1base1}\colorlet{boxbg1}{pal1bg1}\colorlet{boxtitle1}{pal1title1}%
	\colorlet{boxbase2}{pal1base2}\colorlet{boxbg2}{pal1bg2}\colorlet{boxtitle2}{pal1title2}%
	\colorlet{boxbase3}{pal1base3}\colorlet{boxbg3}{pal1bg3}\colorlet{boxtitle3}{pal1title3}%
	\colorlet{boxbase4}{pal1base4}\colorlet{boxbg4}{pal1bg4}\colorlet{boxtitle4}{pal1title4}%
}
\@namedef{coldefs@palette@pal2}{%
	\colorlet{boxbase1}{pal2base1}\colorlet{boxbg1}{pal2bg1}\colorlet{boxtitle1}{pal2title1}%
	\colorlet{boxbase2}{pal2base2}\colorlet{boxbg2}{pal2bg2}\colorlet{boxtitle2}{pal2title2}%
	\colorlet{boxbase3}{pal2base3}\colorlet{boxbg3}{pal2bg3}\colorlet{boxtitle3}{pal2title3}%
	\colorlet{boxbase4}{pal2base4}\colorlet{boxbg4}{pal2bg4}\colorlet{boxtitle4}{pal2title4}%
}
