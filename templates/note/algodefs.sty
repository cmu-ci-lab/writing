\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algodefs}[2026/11/24 v1.0 CIRL algorithm definitions]

% Usage:
%   \usepackage{algodefs}
% then write algorithms as:
%   \begin{algorithm}
%       \caption{\Proc{ProcedureName}$(x)$}
%       \label{alg:name}
%       \begin{algorithmic}[1]
%           \Require \textit{...}
%           \Ensure \textit{...}
%           \State ...
%       \end{algorithmic}
%   \end{algorithm}
% All of the block definitions below are made once, here, so an algorithm body
% only contains the algorithm itself.

\@ifpackageloaded{algorithm}{}{\RequirePackage[ruled]{algorithm}}	% provide `algorithm' and `algorithm*'
\@ifpackageloaded{algpseudocode}{}{\RequirePackage{algpseudocode}}	% provide the `algorithmic' environment, the standard blocks, and the `algorithmic...' keywords; loads `algorithmicx'
\@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}	% needed for `providecolor' and `textcolor'

% `providecolor' so a document that defines its own colors before loading algodefs keeps them
% You can override either color with a `\definecolor` or a `\colorlet` anywhere after you load the package, most naturally in your paper's `.sty` file:
%   \definecolor{algocommentcolor}{RGB}{70, 70, 70}
%   \colorlet{algoaltcommentcolor}{blue}
\providecolor{algocommentcolor}{RGB}{136, 136, 136}	% ordinary comments
\providecolor{algoaltcommentcolor}{RGB}{255, 153, 51}	% a second comment color

% \floatname{algorithm}{Procedure}	% uncomment to caption algorithms as "Procedure" instead

% keywords
\renewcommand{\algorithmicrequire}{\textbf{Input:}}
\renewcommand{\algorithmicensure}{\textbf{Output:}}
\renewcommand{\algorithmicforall}{\textbf{for each}}
\renewcommand{\algorithmicrepeat}{\textbf{do}}
\renewcommand{\algorithmicuntil}{\textbf{while}}
\newcommand{\algorithmicbreak}{\textbf{break}}

% statements
\newcommand{\Break}{\State \algorithmicbreak}
\let\ForEach\ForAll
\let\Do\Repeat
\let\dWhile\Until
\newcommand{\Proc}[1]{\mbox{\textsc{#1}}}
\newcommand{\InputConditions}[1]{\Require \parbox[t]{\dimexpr\linewidth-\algorithmicindent}{#1\strut}}
\newcommand{\OutputConditions}[1]{\Ensure \parbox[t]{\dimexpr\linewidth-\algorithmicindent}{#1\strut}}

% comments
\renewcommand{\Comment}[1]{\hfill\textcolor{algocommentcolor}{\(\triangleright\) \textit{#1}}}
\newcommand{\AltComment}[1]{\hfill\textcolor{algoaltcommentcolor}{\(\triangleright\) \textit{#1}}}
\newcommand{\CommentLine}[1]{\Statex\hspace{-\algorithmicindent}\Comment{#1}}
\newcommand{\AltCommentLine}[1]{\Statex\hspace{-\algorithmicindent}\AltComment{#1}}

% line references: a `\label' on an algorithm line refers to that line, so `\ref' gives "18" and `\cref' gives "Line 18" (without this, `\cref' gives "Algorithm 1")
% Since its November 2024 release, the LaTeX kernel's first aid for cleveref takes a label's type from `\@currentcounter' when `\label' runs. algorithmicx steps its line counter inside each line's number box, so the setting is lost when that box closes and `\@currentcounter' stays `algorithm' from the caption. Setting it once per algorithmic environment keeps it local to that environment.
\g@addto@macro\ALG@beginalgorithmic{\def\@currentcounter{ALG@line}}
\def\theHALG@line{\arabic{algorithm}.\arabic{ALG@line}}	% hyperref link targets unique per algorithm, not only per line number

% With cleveref, line references name their algorithm: `\cref' gives "Algorithm 1, Line 18", "Algorithm 1, Lines 4 and 12" or "Algorithm 1, Lines 1–3" (`\ref' and `\labelcref' still give the bare number).
% Each line's cleveref label text carries its algorithm's number in `\algodefslineprefix', which prints nothing; the formats below take it apart.
% Limitation: in one `\cref' spanning two algorithms, each group's "Line"/"Lines" is chosen without knowing how many lines follow it ("Algorithm 1, Lines 4 and Algorithm 2, Line 3 and 5"); cite each algorithm's lines separately instead.
\protected\def\algodefslineprefix#1{}
\def\algodefs@split#1{\protected@edef\algodefs@tmp{#1}\expandafter\algodefs@split@\algodefs@tmp\@nil}	% sets \algodefs@alg and \algodefs@line
\def\algodefs@split@#1#2#3\@nil{\def\algodefs@alg{#2}\def\algodefs@line{#3}}
% #1 label text, #2 #3 link start and end, #4 algorithm name, #5 line name
\def\algodefs@first#1#2#3#4#5{\algodefs@split{#1}#4~\algodefs@alg, #5~#2\algodefs@line#3\xdef\algodefs@lastalg{\algodefs@alg}}
% #1 conjunction, #2 label text, #3 #4 link start and end, #5 algorithm name, #6 line name (named again only when the algorithm changes)
\def\algodefs@next#1#2#3#4#5#6{#1\algodefs@split{#2}\ifx\algodefs@alg\algodefs@lastalg\else#5~\algodefs@alg, #6~\fi#3\algodefs@line#4\xdef\algodefs@lastalg{\algodefs@alg}}
% ranges: #1 #2 label texts, #3 to #6 link starts and ends, #7 algorithm name, #8 line name
\def\algodefs@range#1#2#3#4#5#6#7#8{\algodefs@first{#1}{#3}{#4}{#7}{#8}\crefrangeconjunction\algodefs@split{#2}#5\algodefs@line#6}
% further ranges: #1 conjunction, #2 #3 label texts, #4 to #7 link starts and ends, #8 algorithm name, #9 line name
\def\algodefs@nextrange#1#2#3#4#5#6#7#8#9{\algodefs@next{#1}{#2}{#4}{#5}{#8}{#9}\crefrangeconjunction\algodefs@split{#3}#6\algodefs@line#7}
% #1 cref or Cref
\def\algodefs@defformats#1{%
	\@nameuse{#1format}{algline}{\algodefs@first{##1}{##2}{##3}{\@nameuse{#1@algorithm@name}}{\@nameuse{#1@line@name}}}%
	\@nameuse{#1rangeformat}{algline}{\algodefs@range{##1}{##2}{##3}{##4}{##5}{##6}{\@nameuse{#1@algorithm@name}}{\@nameuse{#1@line@name@plural}}}%
	\@nameuse{#1multiformat}{algline}%
		{\algodefs@first{##1}{##2}{##3}{\@nameuse{#1@algorithm@name}}{\@nameuse{#1@line@name@plural}}}%
		{\algodefs@next{\crefpairconjunction}{##1}{##2}{##3}{\cref@algorithm@name}{\cref@line@name}}%
		{\algodefs@next{\crefmiddleconjunction}{##1}{##2}{##3}{\cref@algorithm@name}{\cref@line@name}}%
		{\algodefs@next{\creflastconjunction}{##1}{##2}{##3}{\cref@algorithm@name}{\cref@line@name}}%
	\@nameuse{#1rangemultiformat}{algline}%
		{\algodefs@range{##1}{##2}{##3}{##4}{##5}{##6}{\@nameuse{#1@algorithm@name}}{\@nameuse{#1@line@name@plural}}}%
		{\algodefs@nextrange{\crefpairconjunction}{##1}{##2}{##3}{##4}{##5}{##6}{\cref@algorithm@name}{\cref@line@name@plural}}%
		{\algodefs@nextrange{\crefmiddleconjunction}{##1}{##2}{##3}{##4}{##5}{##6}{\cref@algorithm@name}{\cref@line@name@plural}}%
		{\algodefs@nextrange{\creflastconjunction}{##1}{##2}{##3}{##4}{##5}{##6}{\cref@algorithm@name}{\cref@line@name@plural}}}
\AtBeginDocument{\@ifpackageloaded{cleveref}{%
	\def\p@ALG@line{\algodefslineprefix{\thealgorithm}}%
	\let\algodefs@cref@resetby\cref@resetby
	\def\cref@resetby#1#2{\cref@ifstreq{#1}{ALG@line}{\def#2{algorithm}}{\algodefs@cref@resetby{#1}{#2}}}% lines belong to their algorithm, so cleveref sorts and collapses them per algorithm (its own list of parent counters lacks `algorithm')
	\crefalias{ALG@line}{algline}%
	\crefname{algline}{\cref@line@name}{\cref@line@name@plural}%	% the document's own names for lines, for `\namecref'
	\Crefname{algline}{\Cref@line@name}{\Cref@line@name@plural}%
	\algodefs@defformats{cref}\algodefs@defformats{Cref}%
}{}}

% hide the closing keywords of the standard blocks, whose extent the indentation already shows
\algtext*{EndProcedure}
\algtext*{EndFunction}
\algtext*{EndIf}
\algtext*{EndFor}
\algtext*{EndWhile}
\algtext*{EndLoop}

% Single-line block variants of the standard blocks.
\algblockdefx[AlgoDefsBlock]{Struct}{EndStruct}
	[1][Unknown]{\textbf{struct} #1}
	{}
\algtext*{EndStruct}
\algblockdefx[AlgoDefsBlock]{Class}{EndClass}
	[1][Unknown]{\textbf{class} #1}
	{}
\algtext*{EndClass}
\algblockdefx[AlgoDefsBlock]{FORDO}{ENDFORDO}
	[1][Unknown]{\textbf{for} #1 \textbf{do}}
	{}
\algtext*{ENDFORDO}
\algblockdefx[AlgoDefsBlock]{PARALLELFORDO}{ENDPARALLELFORDO}
	[1][Unknown]{\textbf{parallel}\ \textbf{for} #1 \textbf{do}}
	{}
\algtext*{ENDPARALLELFORDO}
\algblockdefx[AlgoDefsBlock]{WHILEDO}{ENDWHILEDO}
	[1][Unknown]{\textbf{while} #1 \textbf{do}}
	{}
\algtext*{ENDWHILEDO}
\algblockdefx[AlgoDefsBlock]{IF}{ENDIF}
	[1][Unknown]{\textbf{if} #1 \textbf{then}}
	{}
\algtext*{ENDIF}
\algblockdefx[AlgoDefsBlock]{ELSEIF}{ENDELSEIF}
	[1][Unknown]{\textbf{else if} #1 \textbf{then}}
	{}
\algtext*{ENDELSEIF}
\algblockdefx[AlgoDefsBlock]{ELSE}{ENDELSE}
	{\textbf{else}}
	{}
\algtext*{ENDELSE}
\algblockdefx[AlgoDefsBlock]{IFTHEN}{ENDIFTHEN}
	[2][Unknown]{\textbf{if} #1 \textbf{then} #2}
	{}
\algtext*{ENDIFTHEN}
\algblockdefx[AlgoDefsBlock]{ELSEIFTHEN}{ENDELSEIFTHEN}
	[2][Unknown]{\textbf{else if} #1 \textbf{then} #2}
	{}
\algtext*{ENDELSEIFTHEN}
\algblockdefx[AlgoDefsBlock]{RETURN}{ENDRETURN}
	[1][Unknown]{\textbf{return} #1}
	{}
\algtext*{ENDRETURN}
\algblockdefx[AlgoDefsBlock]{COMMENT}{ENDCOMMENT}
	[1][Unknown]{\textcolor{algocommentcolor}{\(\triangleright\) \textit{#1}}}
	{}
\algtext*{ENDCOMMENT}
\algblockdefx[AlgoDefsBlock]{ALTCOMMENT}{ENDALTCOMMENT}
	[1][Unknown]{\textcolor{algoaltcommentcolor}{\(\triangleright\) \textit{#1}}}
	{}
\algtext*{ENDALTCOMMENT}
\algblockdefx[AlgoDefsBlock]{SUBCOMMENT}{ENDSUBCOMMENT}
	[1][Unknown]{\textcolor{algoaltcommentcolor}{\(\triangleright\quad\) \textit{#1}}}
	{}
\algtext*{ENDSUBCOMMENT}
